/* ============================================================
   NORTE PADEL V80 — PRODUCT REBUILD / PRO SYSTEM
   Visual layer only. Keeps existing DOM ids, Supabase data and JS contracts.
   ============================================================ */
:root{
  --v80-bg:#050708;
  --v80-surface:#0a0e0c;
  --v80-surface-2:#0f1411;
  --v80-text:#f3f6f3;
  --v80-muted:#8d9891;
  --v80-line:rgba(255,255,255,.10);
  --v80-line-2:rgba(255,255,255,.06);
  --v80-green:#74f542;
  --v80-green-dark:#17311f;
  --v80-gold:#d9bd72;
  --v80-max:1480px;
  --v80-nav-h:72px;
  --v80-ease:cubic-bezier(.2,.7,.2,1);
}
html,body{background:var(--v80-bg)!important;color:var(--v80-text)!important}
body{font-family:Manrope,system-ui,sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:.018;background-image:radial-gradient(rgba(255,255,255,.8) .5px,transparent .5px);background-size:4px 4px}

/* ---------- shell ---------- */
.np-site-header{height:var(--v80-nav-h)!important;background:rgba(5,7,8,.82)!important;backdrop-filter:blur(14px);border-bottom:1px solid var(--v80-line)!important;z-index:1000!important}
.np-brand{padding-left:24px!important}.np-brand-mark{width:38px!important;height:38px!important}.np-brand-copy strong{font-size:18px!important;letter-spacing:.14em!important}.np-brand-copy em{font-size:18px!important}.np-brand-copy small{font-size:8px!important;letter-spacing:.24em!important;color:#7d8881!important}
.np-header-center{font-size:9px!important;letter-spacing:.22em!important}
.np-live-mark i{width:7px!important;height:7px!important;background:var(--v80-green)!important;box-shadow:0 0 18px rgba(116,245,66,.55)}
.np-header-actions{padding-right:24px!important}.np-header-icon,.np-profile-trigger{border-color:var(--v80-line)!important;background:#070a09!important}.np-header-icon:hover,.np-profile-trigger:hover{border-color:rgba(116,245,66,.45)!important;transform:translateY(-1px)}

/* nav: light, editorial, always separate from page content */
.tabbar.np-nav{position:sticky!important;top:var(--v80-nav-h)!important;z-index:900!important;height:52px!important;background:rgba(4,6,7,.86)!important;border-bottom:1px solid var(--v80-line)!important;backdrop-filter:blur(12px)!important}
.tabbar.np-nav .tab{height:52px!important;min-width:120px!important;background:transparent!important;color:#6e7871!important;border:0!important;border-radius:0!important;font-size:10px!important;letter-spacing:.24em!important;font-weight:800!important;transition:color .25s var(--v80-ease),transform .25s var(--v80-ease)}
.tabbar.np-nav .tab .icon{display:none!important}.tabbar.np-nav .tab.active{color:#fff!important;box-shadow:inset 0 -2px 0 var(--v80-green)!important}.tabbar.np-nav .tab:hover{color:#fff!important;transform:translateY(-1px)}

/* ---------- page transitions / common ---------- */
.view.active{animation:v80PageIn .45s var(--v80-ease) both;min-height:calc(100svh - var(--v80-nav-h) - 52px)!important}
@keyframes v80PageIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.np-kicker{font-size:9px!important;letter-spacing:.26em!important;color:var(--v80-green)!important;font-weight:800!important}
.np-display{font-family:Manrope,system-ui,sans-serif!important;font-weight:900!important;letter-spacing:-.075em!important;text-transform:uppercase!important}
.np-cta{border-radius:0!important;border:1px solid rgba(255,255,255,.12)!important;box-shadow:none!important;background:#f3f6f3!important;color:#050708!important;font-size:10px!important;letter-spacing:.2em!important;font-weight:900!important;min-height:44px!important;padding:0 18px!important;transition:transform .25s var(--v80-ease),background .25s,border-color .25s}
.np-cta:hover{transform:translateY(-2px);background:var(--v80-green)!important}.np-inline-link,.np-ghost-cta{font-size:10px!important;letter-spacing:.18em!important;font-weight:900!important;color:#f4f6f4!important}.np-inline-link:hover,.np-ghost-cta:hover{color:var(--v80-green)!important}

/* ---------- home: full-width, no dashboard feel ---------- */
.np-home{background:#050708!important}
.np-hero{height:calc(100svh - var(--v80-nav-h) - 52px)!important;min-height:720px!important;width:100%!important;margin:0!important;position:relative!important;overflow:hidden!important;border-bottom:1px solid var(--v80-line)!important}
.np-hero-bg{position:absolute!important;inset:0!important;background-image:linear-gradient(90deg,rgba(3,5,6,.96) 0%,rgba(3,5,6,.75) 34%,rgba(3,5,6,.18) 72%,rgba(3,5,6,.72) 100%),url('editorial-action-01.webp')!important;background-size:cover!important;background-position:center 35%!important;filter:none!important}
.np-hero-bg:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 76% 46%,transparent 0 18%,rgba(3,5,6,.20) 42%,rgba(3,5,6,.75) 100%)}
.np-hero:after{content:"";position:absolute;inset:auto 0 0;height:32%;background:linear-gradient(180deg,transparent,#050708 92%);pointer-events:none}
.np-hero-copy{position:absolute!important;z-index:4!important;left:max(5vw,40px)!important;bottom:13vh!important;width:min(710px,55vw)!important}
.np-hero-title{font-size:clamp(72px,10vw,170px)!important;line-height:.78!important;margin:24px 0!important;color:#f3f6f3!important}.np-hero-title span{color:var(--v80-green)!important}
.np-hero-sub{max-width:45ch!important;color:#b6c0b9!important;font-size:15px!important;line-height:1.6!important}
.np-hero-cta-row{display:flex!important;align-items:center!important;gap:18px!important;margin-top:28px!important}
.np-hero-feature-image{display:none!important}
.np-hero-side{left:auto!important;right:24px!important;top:28%!important;z-index:3!important;color:#768078!important}.np-hero-side span{font-size:9px!important;letter-spacing:.18em}.np-hero-side i{height:140px!important;background:linear-gradient(var(--v80-green),transparent)!important}
.np-hero-position{z-index:4!important;border:1px solid var(--v80-line)!important;background:rgba(4,7,6,.58)!important;backdrop-filter:blur(10px)!important;border-radius:0!important}.np-hero-bottom{z-index:5!important;color:#8b958e!important;border-top:1px solid var(--v80-line)!important;padding:12px max(5vw,40px)!important;font-size:8px!important;letter-spacing:.24em!important}

/* ---------- next matches: single broadcast rail ---------- */
.np-upcoming-section{padding:110px max(5vw,32px) 130px!important;background:linear-gradient(180deg,#050708,#08100b)!important}
.np-section{width:100%!important;max-width:var(--v80-max)!important;margin:0 auto!important}
.np-section-head{display:flex!important;justify-content:space-between!important;align-items:end!important;gap:24px!important;border-bottom:1px solid var(--v80-line)!important;padding-bottom:20px!important;margin-bottom:28px!important}
.np-section-head h3{font-size:clamp(44px,5.3vw,84px)!important;line-height:.88!important;margin:9px 0 0!important;letter-spacing:-.07em!important;text-transform:uppercase!important}
.np-section-index{font-size:9px!important;letter-spacing:.22em!important;color:#6f7a73!important}
.np-match-rail{display:flex!important;overflow:hidden!important;gap:18px!important}
.np-match-rail>*{flex:0 0 min(100%,760px)!important}
.np-match-rail-controls{display:flex!important;align-items:center!important;justify-content:space-between!important;margin-top:18px!important}.np-rail-arrow{width:46px!important;height:46px!important;border:1px solid var(--v80-line)!important;border-radius:0!important;background:#080c0a!important;color:#dfe6e1!important}.np-rail-arrow:hover{border-color:rgba(116,245,66,.5)!important;color:var(--v80-green)!important}
.np-rail-dots{display:flex!important;gap:8px!important}.np-rail-dots button{width:5px!important;height:5px!important;border-radius:50%!important;background:#465048!important;border:0!important}.np-rail-dots button.active{width:22px!important;border-radius:2px!important;background:var(--v80-green)!important}

/* match cards become wide broadcast banners */
.np-match-rail .match-card,.np-match-rail .np-match-card,.np-match-rail .match-poster,.np-match-rail .match-card-feature{border:1px solid var(--v80-line)!important;border-radius:0!important;background:#080c0a!important;box-shadow:none!important;min-height:330px!important;position:relative!important;overflow:hidden!important}
.np-match-rail .match-card:before,.np-match-rail .np-match-card:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,5,6,.97) 0%,rgba(3,5,6,.66) 50%,rgba(3,5,6,.28) 100%),url('editorial-action-02.webp') center/cover no-repeat;opacity:.66}
.np-match-rail .match-card>* , .np-match-rail .np-match-card>*{position:relative;z-index:2}

/* ---------- home editorial rhythm ---------- */
.np-feed-section{padding:85px max(5vw,32px)!important}.np-results-column{min-width:0}.np-news-grid{display:grid!important;grid-template-columns:minmax(0,1fr) 260px!important;gap:40px!important;max-width:var(--v80-max)!important;margin:auto!important}
.np-results-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:0!important;border-top:1px solid var(--v80-line)!important}.np-results-grid>*{border-bottom:1px solid var(--v80-line)!important}
.np-aside-ticker{border-left:1px solid var(--v80-line)!important;padding:14px 0 14px 24px!important;display:flex!important;flex-direction:column!important;justify-content:space-between!important;min-height:360px!important}.np-aside-ticker strong{font-size:clamp(40px,5vw,78px)!important;line-height:.85!important;letter-spacing:-.08em!important}
.np-feature-breaker{max-width:none!important;margin:0!important;min-height:720px!important;border-top:1px solid var(--v80-line)!important;border-bottom:1px solid var(--v80-line)!important;position:relative!important;background:#06100a!important;display:grid!important;grid-template-columns:18% 52% 30%!important;align-items:stretch!important;overflow:hidden!important}.np-feature-number{font-size:clamp(100px,17vw,270px)!important;line-height:.75!important;align-self:end!important;color:rgba(255,255,255,.06)!important;padding:30px!important;z-index:1!important}.np-feature-image{grid-column:2!important;background:url('editorial-action-03.webp') center/cover!important;min-height:720px!important;filter:saturate(.9)!important}.np-feature-copy{grid-column:3!important;align-self:end!important;padding:60px!important;z-index:2!important}.np-feature-copy h3{font-size:clamp(46px,5vw,88px)!important;line-height:.86!important;letter-spacing:-.08em!important}.np-feature-copy em{color:var(--v80-green)!important;font-style:normal}
.np-player-of-month-band{max-width:none!important;margin:0!important;padding:120px max(5vw,40px)!important;background:#080c0a!important;border-bottom:1px solid var(--v80-line)!important}.np-player-of-month-band .destacados-grid{max-width:var(--v80-max)!important;margin:auto!important}
.np-tournaments-section{padding:120px max(5vw,32px)!important}.np-tournament-showcase{max-width:var(--v80-max)!important;margin:auto!important;display:grid!important;grid-template-columns:1.4fr .8fr!important;gap:20px!important;align-items:stretch!important}.np-tournament-showcase>#flyerDestacado{min-height:640px!important}.np-tournament-showcase .flyer-grid{display:grid!important;grid-template-columns:1fr 1fr!important;gap:20px!important}
.np-split-story{max-width:none!important;min-height:620px!important;display:grid!important;grid-template-columns:1fr 1fr!important;border-top:1px solid var(--v80-line)!important;border-bottom:1px solid var(--v80-line)!important}.np-story-copy{padding:80px max(5vw,32px)!important}.np-story-copy h3{font-size:clamp(50px,7vw,110px)!important;line-height:.82!important;letter-spacing:-.08em!important}.np-story-copy em{color:var(--v80-green)!important;font-style:normal}.np-story-image{background:url('editorial-community.webp') center/cover!important;min-height:620px!important}
.np-brazil-band{min-height:520px!important;background-image:linear-gradient(90deg,rgba(3,5,6,.82),rgba(3,5,6,.15)),url('brasil-tour.webp')!important;background-size:cover!important;background-position:center!important}.np-brazil-band .energia-texto{max-width:var(--v80-max)!important;margin:auto!important;padding:90px 5vw!important}.np-brazil-band h3{font-size:clamp(56px,7vw,110px)!important;line-height:.85!important;letter-spacing:-.08em!important}
.np-sponsors-section{padding:110px max(5vw,32px)!important;background:#050708!important}.np-sponsors-section .sponsor-strip{max-width:var(--v80-max)!important;margin:auto!important;display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:2px!important}.np-sponsors-section .sponsor-item{min-height:170px!important;background:#050708!important;border:1px solid var(--v80-line)!important;display:flex!important;align-items:center!important;justify-content:center!important}.np-sponsors-section .sponsor-item img{width:min(82%,250px)!important;max-height:100px!important;object-fit:contain!important;filter:grayscale(1) brightness(1.55)!important;transition:filter .3s,transform .3s}.np-sponsors-section .sponsor-item:hover img{filter:none!important;transform:scale(1.04)}

/* app section */
.np-app-section{max-width:none!important;margin:0!important;padding:120px max(5vw,32px)!important;background:#06100a!important;border-top:1px solid var(--v80-line)!important}.np-app-copy h3{font-size:clamp(58px,7.5vw,130px)!important;line-height:.82!important}.np-app-phone{border-radius:24px!important;border-color:rgba(116,245,66,.25)!important}

/* ---------- ranking ---------- */
.np-ranking-view{background:radial-gradient(circle at 70% 0%,rgba(116,245,66,.08),transparent 32%),#050708!important}.np-ranking-hero{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important;padding:100px 0 70px!important;border-bottom:1px solid var(--v80-line)!important}.np-ranking-hero .np-page-number{font-size:clamp(120px,19vw,280px)!important;color:rgba(255,255,255,.07)!important}.np-ranking-hero .np-display{font-size:clamp(70px,9vw,140px)!important;line-height:.78!important}
.np-ranking-filters{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important;padding:18px 0!important;border-bottom:1px solid var(--v80-line)!important;display:flex!important;gap:20px!important;flex-wrap:wrap!important}.np-ranking-filters .pill-row{display:flex!important;gap:6px!important}.np-ranking-filters .pill{border:0!important;background:transparent!important;color:#727d75!important;padding:9px 0!important;margin-right:22px!important;border-radius:0!important;border-bottom:1px solid transparent!important;letter-spacing:.14em!important;font-size:10px!important}.np-ranking-filters .pill.active{color:#fff!important;background:transparent!important;border-bottom-color:var(--v80-green)!important}
.np-ranking-stage{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important;padding:35px 0 100px!important}.np-ranking-title-row{display:grid!important;grid-template-columns:100px 1fr 150px 150px!important;gap:20px!important;font-size:8px!important;letter-spacing:.22em!important;color:#6f7972!important;padding:12px 18px!important;border-bottom:1px solid var(--v80-line)!important}
#tablaRanking{width:100%!important;border-collapse:collapse!important;border-spacing:0!important}#tablaRanking tr{display:grid!important;grid-template-columns:100px 1fr 150px 150px!important;gap:20px!important;align-items:center!important;padding:0 18px!important;border-bottom:1px solid var(--v80-line-2)!important;min-height:112px!important;background:transparent!important;transition:background .25s,transform .25s!important}#tablaRanking tr:hover{background:rgba(116,245,66,.035)!important;transform:translateX(5px)}#tablaRanking td{border:0!important;padding:0!important;color:#dce3de!important;font-size:13px!important}#tablaRanking td:first-child{font:900 72px/.8 Manrope,sans-serif!important;letter-spacing:-.08em!important;color:rgba(255,255,255,.22)!important}#tablaRanking tr:first-child td:first-child{color:var(--v80-green)!important}#tablaRanking td:nth-child(2)>div{gap:18px!important}.avatar-master{width:72px!important;height:72px!important;border-radius:50%!important;border:1px solid rgba(255,255,255,.18)!important}.avatar-master img{width:100%!important;height:100%!important;object-fit:cover!important;border-radius:50%!important}.fila-master td:nth-child(2) span{font-size:18px!important;font-weight:900!important;letter-spacing:.04em!important;text-transform:uppercase}.fila-master td:nth-child(3) strong{font-size:42px!important;color:var(--v80-green)!important;letter-spacing:-.06em!important}.fila-master td:nth-child(n+4){color:#7f8a82!important;font-size:9px!important;letter-spacing:.12em!important}.fila-master .badge{border-color:rgba(217,189,114,.5)!important;color:var(--v80-gold)!important;background:transparent!important;font-size:8px!important}

/* ---------- tournament index ---------- */
.np-torneos-view{background:#050708!important}.np-page-hero{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important;padding:100px 0 54px!important;border-bottom:1px solid var(--v80-line)!important}.np-page-hero .np-display{font-size:clamp(70px,9vw,140px)!important;line-height:.78!important}.np-tournament-list{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important;display:grid!important;grid-template-columns:repeat(12,1fr)!important;gap:2px!important}.np-tournament-list .torneo-card-poster{grid-column:span 6!important;min-height:500px!important;border:1px solid var(--v80-line)!important;border-radius:0!important;background:#080c0a!important;position:relative!important;overflow:hidden!important}.np-tournament-list .torneo-card-poster:nth-child(3n){grid-column:span 4!important;min-height:420px!important}.np-tournament-list .torneo-card-poster:nth-child(4n){grid-column:span 8!important}.np-tournament-list .torneo-card-poster:hover{transform:none!important;border-color:rgba(116,245,66,.35)!important}.np-tournament-list .torneo-card-poster img{width:100%!important;height:100%!important;object-fit:cover!important}.np-tournament-list .torneo-card-header{position:absolute!important;inset:auto 0 0!important;padding:28px!important;background:linear-gradient(transparent,rgba(0,0,0,.95))!important}.np-tournament-list .torneo-nombre{font-size:clamp(24px,3vw,44px)!important;font-weight:900!important;letter-spacing:-.05em!important;text-transform:uppercase!important}.np-tournament-list .torneo-lugar{color:#b2bcb5!important}

/* ---------- tournament event page ---------- */
.np-event-view,.np-event-info-view{background:#050708!important}.np-event-hero{min-height:78svh!important;position:relative!important;overflow:hidden!important;background:#06100a!important}.np-event-art{inset:0!important}.np-event-art:after{content:"";position:absolute;inset:0!important;background-image:linear-gradient(90deg,rgba(3,5,6,.96),rgba(3,5,6,.44) 50%,rgba(3,5,6,.62)),url('editorial-action-04.webp')!important;background-size:cover!important;background-position:center!important;opacity:.92!important}.np-event-overlay{left:max(5vw,40px)!important;bottom:10vh!important;right:5vw!important}.np-event-overlay h2{font-size:clamp(64px,9vw,150px)!important;line-height:.78!important;letter-spacing:-.08em!important;text-transform:uppercase!important;max-width:1000px!important}.np-event-actionbar{max-width:none!important;margin:0!important;padding:30px 5vw!important;border-bottom:1px solid var(--v80-line)!important;background:#070a09!important;display:flex!important;justify-content:space-between!important;align-items:center!important}.np-event-results,.np-event-info-view>div{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:0 auto!important}.np-event-results{padding-top:90px!important}.np-competition-state{border-bottom:1px solid var(--v80-line)!important}.np-filter-rail{padding:18px 0!important;border-bottom:1px solid var(--v80-line)!important}.np-event-info-view{padding-bottom:100px!important}.np-event-inside-art{min-height:70svh!important}.np-event-inside-copy h2{font-size:clamp(62px,8vw,130px)!important;line-height:.82!important}
#torneoContextBar{position:sticky!important;top:calc(var(--v80-nav-h) + 52px)!important;z-index:850!important;background:rgba(5,7,8,.92)!important;backdrop-filter:blur(12px)!important;border-bottom:1px solid var(--v80-line)!important}
#torneoSubnav{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;padding:10px 0!important}.np-event-view #torneoSubnav .pill,.np-event-info-view #torneoSubnav .pill{background:transparent!important;border-radius:0!important;border:0!important;color:#7a847d!important;letter-spacing:.13em!important;font-size:9px!important}.np-event-view #torneoSubnav .pill.active,.np-event-info-view #torneoSubnav .pill.active{color:#fff!important;background:transparent!important;border-bottom:1px solid var(--v80-green)!important}

/* ---------- join ---------- */
.np-join-view{background:radial-gradient(circle at 20% 20%,rgba(116,245,66,.08),transparent 32%),#080b0a!important}.np-join-hero{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;padding:100px 0 72px!important;border-bottom:1px solid var(--v80-line)!important}.np-join-hero h2{font-size:clamp(70px,10vw,160px)!important;line-height:.78!important;letter-spacing:-.09em!important}.np-join-hero h2 em{color:var(--v80-green)!important;font-style:normal}.np-join-layout{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;display:grid!important;grid-template-columns:230px 1fr!important;min-height:600px!important}.np-step-rail{padding:42px 30px 70px 0!important;border-right:1px solid var(--v80-line)!important}.np-step{display:flex!important;gap:14px!important;align-items:center!important;padding:18px 0!important;border-bottom:1px solid var(--v80-line-2)!important}.np-step b{font-size:36px!important;color:#556159!important}.np-step.active b{color:var(--v80-green)!important}.np-step span{font-size:8px!important;letter-spacing:.18em!important}.np-join-content{padding:42px 0 100px 60px!important;max-width:760px!important}.np-join-step h3{font-size:clamp(36px,4vw,64px)!important;line-height:.9!important;letter-spacing:-.06em!important;text-transform:uppercase!important}

/* ---------- profile / login ---------- */
.np-profile-view{background:#050708!important}.np-profile-shell{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;padding-bottom:120px!important}.np-auth-card{width:min(520px,100%)!important;margin:60px 0!important;border-radius:0!important;background:#080c0a!important;border:1px solid var(--v80-line)!important;box-shadow:none!important;padding:32px!important}.np-auth-card h2,.np-profile-form h2{font-size:clamp(42px,5vw,72px)!important;line-height:.88!important;letter-spacing:-.07em!important;text-transform:uppercase!important}.np-profile-form,.np-profile-status{border:1px solid var(--v80-line)!important;border-radius:0!important;background:#080c0a!important;box-shadow:none!important}.np-photo-uploader .avatar-grande{width:150px!important;height:150px!important;border-radius:50%!important}

/* ---------- public player profile ---------- */
.np-player-view{background:#050708!important}.np-player-hero{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;min-height:620px!important;display:grid!important;grid-template-columns:minmax(360px,45%) 1fr!important;gap:60px!important;align-items:end!important;padding:90px 0!important;border-bottom:1px solid var(--v80-line)!important}.np-player-photo{min-height:540px!important;background-size:cover!important;background-position:center!important;border:1px solid var(--v80-line)!important}.np-player-heading h2{font-size:clamp(70px,9vw,150px)!important;line-height:.78!important;letter-spacing:-.09em!important;text-transform:uppercase!important}.np-player-score{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important;display:grid!important;grid-template-columns:repeat(4,1fr)!important;border-bottom:1px solid var(--v80-line)!important}.np-player-score>div{padding:34px 22px!important;border-right:1px solid var(--v80-line)!important}.np-player-score strong{font-size:clamp(34px,5vw,72px)!important;letter-spacing:-.07em!important;color:var(--v80-green)!important}.np-player-score span{display:block!important;color:#778179!important;font-size:8px!important;letter-spacing:.2em!important;margin-top:10px!important}

/* ---------- admin: operational software ---------- */
#view-admin{background:#070a09!important;padding-bottom:120px!important}.admin-wrap{width:min(var(--v80-max),calc(100vw - 10vw))!important;margin:auto!important}.admin-wrap .card{border-radius:0!important;border:1px solid var(--v80-line)!important;background:#0b0f0d!important;box-shadow:none!important}.admin-wrap h2{font-size:clamp(24px,3vw,44px)!important;letter-spacing:-.05em!important;text-transform:uppercase!important}.admin-wrap input,.admin-wrap select,.admin-wrap textarea{border-radius:0!important;background:#050708!important;border-color:var(--v80-line)!important}.admin-wrap button.primary,.admin-wrap button.secondary{border-radius:0!important}

/* ---------- accessibility / motion ---------- */
button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--v80-green)!important;outline-offset:3px!important}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}

/* ---------- tablet/mobile ---------- */
@media(max-width:959px){
  :root{--v80-nav-h:64px}
  .np-site-header{height:64px!important}.np-brand{padding-left:14px!important}.np-brand-copy strong,.np-brand-copy em{font-size:15px!important}.np-header-actions{padding-right:14px!important}.np-header-center{display:none!important}
  .tabbar.np-nav{top:64px!important}.tabbar.np-nav .tab{min-width:86px!important;font-size:8px!important;letter-spacing:.17em!important}
  .np-hero{min-height:calc(100svh - 116px)!important;height:auto!important}.np-hero-bg{background-position:62% center!important}.np-hero-copy{left:20px!important;bottom:90px!important;width:calc(100% - 40px)!important}.np-hero-title{font-size:clamp(58px,16vw,100px)!important}.np-hero-sub{font-size:13px!important}.np-hero-bottom{padding:10px 20px!important;font-size:7px!important}.np-hero-side{display:none!important}
  .np-upcoming-section,.np-feed-section,.np-tournaments-section,.np-sponsors-section{padding-left:20px!important;padding-right:20px!important}.np-news-grid{grid-template-columns:1fr!important}.np-aside-ticker{display:none!important}.np-results-grid{grid-template-columns:1fr!important}.np-feature-breaker{grid-template-columns:1fr!important;min-height:0!important}.np-feature-number{position:absolute!important;right:-10px!important;top:10px!important}.np-feature-image{grid-column:1!important;min-height:420px!important}.np-feature-copy{grid-column:1!important;padding:38px 20px 70px!important}.np-story-copy{padding:60px 20px!important}.np-story-image{min-height:400px!important}.np-split-story{grid-template-columns:1fr!important}
  .np-tournament-showcase{grid-template-columns:1fr!important}.np-tournament-showcase>#flyerDestacado{min-height:480px!important}.np-tournament-showcase .flyer-grid{grid-template-columns:1fr 1fr!important}.np-sponsors-section .sponsor-strip{grid-template-columns:1fr 1fr!important}
  .np-ranking-hero,.np-ranking-filters,.np-ranking-stage,.np-page-hero,.np-profile-shell,.np-player-hero,.np-player-score,.np-join-hero,.np-join-layout,.np-event-results,.np-event-info-view>div{width:calc(100vw - 40px)!important}.np-ranking-title-row{grid-template-columns:56px 1fr 90px!important}.np-ranking-title-row span:last-child{display:none!important}#tablaRanking tr{grid-template-columns:56px 1fr 90px!important;min-height:88px!important}#tablaRanking td:last-child{display:none!important}#tablaRanking td:first-child{font-size:52px!important}.avatar-master{width:58px!important;height:58px!important}.fila-master td:nth-child(2) span{font-size:13px!important}.fila-master td:nth-child(3) strong{font-size:31px!important}
  .np-tournament-list{width:calc(100vw - 40px)!important;grid-template-columns:1fr 1fr!important}.np-tournament-list .torneo-card-poster,.np-tournament-list .torneo-card-poster:nth-child(3n),.np-tournament-list .torneo-card-poster:nth-child(4n){grid-column:span 1!important;min-height:320px!important}.np-tournament-list .torneo-card-poster:first-child{grid-column:span 2!important;min-height:500px!important}
  .np-event-hero{min-height:72svh!important}.np-event-overlay{left:20px!important;right:20px!important;bottom:58px!important}.np-event-overlay h2{font-size:clamp(54px,13vw,98px)!important}.np-event-actionbar{padding:18px 20px!important}.np-event-results{padding-top:50px!important}.np-join-layout{grid-template-columns:1fr!important}.np-step-rail{border-right:0!important;border-bottom:1px solid var(--v80-line)!important;display:flex!important;padding:10px 0!important}.np-step{flex:1!important;justify-content:center!important;border-bottom:0!important}.np-join-content{padding:38px 0 80px!important}.np-player-hero{grid-template-columns:1fr!important;gap:28px!important;min-height:0!important}.np-player-photo{min-height:470px!important}.np-player-score{grid-template-columns:1fr 1fr!important}.np-player-score>div{border-bottom:1px solid var(--v80-line)!important}.np-player-heading h2{font-size:clamp(64px,14vw,110px)!important}
}
@media(max-width:620px){
  .np-brand-copy small{display:none!important}.np-profile-trigger #perfilNombreCorto{display:none!important}.tabbar.np-nav .tab{min-width:76px!important}.np-hero-cta-row{flex-wrap:wrap!important}.np-app-section{padding-left:20px!important;padding-right:20px!important}.np-tournament-showcase .flyer-grid{grid-template-columns:1fr!important}.np-sponsors-section .sponsor-strip{grid-template-columns:1fr!important}.np-sponsors-section .sponsor-item{min-height:130px!important}.np-match-rail>*{flex-basis:100%!important}.np-match-rail .match-card,.np-match-rail .np-match-card{min-height:420px!important}.np-event-inside-art{min-height:480px!important}.np-event-inside-copy h2{font-size:52px!important}.np-page-hero .np-display,.np-ranking-hero .np-display{font-size:64px!important}
}
